# Dependencies only; the repository is mounted at run time. Build: ./run.sh build
Bootstrap: docker
From: python:3.12-slim-bookworm

%files
    requirements.txt /opt/requirements.txt
    Python-RVO2 /opt/Python-RVO2

%post
    ...
    pip install --no-cache-dir -r /opt/requirements.txt
    cd /opt/Python-RVO2
    CMAKE_POLICY_VERSION_MINIMUM=3.5 python setup.py build
    pip install --no-cache-dir --no-build-isolation .
    cd /
    rm -rf /opt/Python-RVO2
